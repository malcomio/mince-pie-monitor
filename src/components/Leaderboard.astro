---
import Score from './Score.astro';

const pies = Astro.props.pies;

---
<div class='p-3 bg-stone-50 shadow-xl mb-8 mt-8 rounded-lg'>
    <h2 class='list-head mb-4 text-3xl text-center'>
        🥧 Mince Pie Leaderboard 🥧
    </h2>
    <table class='table-auto w-full text-left'>
        <thead class='bg-gray-200 border-gray-200'>
        <tr>
            <th class='p-1'>Rank</th>
            <th class='p-1'>Pie</th>
            <th class='p-1'>Score</th>
        </tr>
        </thead>
        <tbody>
        {pies.map((pie: any, index: number) => (
            <tr class='odd:bg-white even:bg-gray-50'>
                <td class='p-1'>{index + 1}</td>
                <td class='p-1'>
                    <a href={'/pies/' + pie.id + '/'} class='hover:underline'>
                        {pie.data.title}
                    </a>
                </td>
                <td class='p-1'>
                    <Score score={pie.data.score}/>
                </td>
            </tr>
        ))}
        </tbody>
    </table>
</div>