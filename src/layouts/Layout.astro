---
import "../styles/global.css";


const defaultTitle = "Máiréad's mince pie monitor 2026";

const title = Astro.props.title ? `${Astro.props.title} | ${defaultTitle}` : defaultTitle;
const description = Astro.props.description || "Reviewing the nation's mince pies.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
	    <link rel="icon"
			href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🥧</text></svg>"/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
