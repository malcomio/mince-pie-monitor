---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Score from '../../../components/Score.astro';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';

export async function getStaticPaths() {
	const pies = await getCollection('pies');
	return pies.map((pie, index) => ({
		params: { slug: pie.id },
		props: { pie, position: index + 1 },
	}));
}

const { pie, position } = Astro.props;
const { Content } = await render(pie);
---

<Layout>
	<Header />
	<div class="p-3 bg-stone-50 shadow-xl mb-8 mt-8 rounded-lg">
		<h2 class="text-3xl font-bold text-center">{pie.data.shop && `${pie.data.shop} `}{pie.data.title}</h2>
	</div>
	
	<div class="p-3 bg-stone-50 shadow-xl mb-8 mt-8 rounded-lg grid sm:grid-cols-2">

		{pie.data.image && <Picture src={pie.data.image} alt={pie.data.title} />}

		<div class="p-3">
			<div class="pb-3 text-4xl">
				<Score score={pie.data.score} position={position} />
			</div>
			<Content />
		</div>
	</div>
</Layout>