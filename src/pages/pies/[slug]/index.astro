---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Score from '../../../components/Score.astro';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';

export async function getStaticPaths() {
	const pies = await getCollection('pies');
	return pies.map((pie) => ({
		params: { slug: pie.id },
		props: { pie },
	}));
}

const { pie } = Astro.props;
const { Content } = await render(pie);
---

<Layout>
	<Header />
	<div class="p-3 bg-stone-50 shadow-xl mb-8 mt-8 rounded-lg">
		<h2 class="text-3xl font-bold text-center">{pie.data.shop && `${pie.data.shop} `}{pie.data.title}</h2>
	</div>
	
	<div class="p-3 bg-stone-50 shadow-xl mb-8 mt-8 rounded-lg flex">

		{pie.data.image && <Picture src={pie.data.image} alt={pie.data.title} />}

		<div class="p-3">
			<div class="pb-3">
				{pie.data.score !== undefined && <Score score={pie.data.score} />}
			</div>
			<Content />
		</div>
	</div>
</Layout>